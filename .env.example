# ============================================================
# Bike Assembly MES 环境变量样例
# 复制为 .env 后 docker compose 会自动读取；切勿提交真实密钥
# ============================================================

# 部署模式
#   prod：启动时校验 JWT 密钥（必须 ≥32 字符且不能是占位值）
#   dev ：使用 application-dev.yml 内置占位密钥（仅本地演示）
SPRING_PROFILES_ACTIVE=prod

# JWT 签名密钥（生产环境必须设置且长度 ≥32 字符）
JWT_ADMIN_SECRET=replace-with-random-secret-0123456789abcdef
JWT_APP_SECRET=replace-with-random-secret-0123456789fedcba

# 微信小程序凭据（后端 /app/** 登录与绑定）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Local OpenAI-compatible chat service (enable the local-chat Compose profile)
AI_OPENAI_BASE_URL=http://chat-model:8000/v1
AI_OPENAI_API_KEY=local-chat-key
AI_CHAT_MODEL=Eslzzyl/Qwen3-4B-Instruct-2507-AWQ
AI_EMBEDDING_BASE_URL=http://embedding-cpu:8000/v1
AI_EMBEDDING_API_KEY=local-embedding-key
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=120
AI_REASONING_EFFORT=medium
AI_CONTEXT_MAX_CHARS=12000
AI_RAG_MIN_SIMILARITY=0.70

# 可选 PGVector RAG
AI_PGVECTOR_ENABLED=true
AI_PGVECTOR_URL=jdbc:postgresql://pgvector:5432/mes_ai
AI_PGVECTOR_USERNAME=mes
AI_PGVECTOR_PASSWORD=mes123456
# 首次连接空库时建议为 true；已有表且希望禁止自动 DDL 时改为 false
AI_PGVECTOR_INITIALIZE_SCHEMA=true
AI_PGVECTOR_SCHEMA_VALIDATION=false
AI_PGVECTOR_DIMENSIONS=1024
AI_PGVECTOR_TABLE=vector_store_bge_m3_1024
AI_KNOWLEDGE_PATH=docs
AI_PUBLIC_KNOWLEDGE_UPLOAD_PATH=/app/data/ai/public-uploads
AI_PRIVATE_KNOWLEDGE_PATH=/app/data/ai/private

# Local model files (prepare these paths before enabling their Compose profiles)
LOCAL_CHAT_IMAGE=vllm/vllm-openai:v0.32.0
LOCAL_CHAT_MODEL=Eslzzyl/Qwen3-4B-Instruct-2507-AWQ
LOCAL_CHAT_MODEL_PATH=/models/qwen3-4b-awq
LOCAL_CHAT_MODEL_PATH_HOST=./models/qwen3-4b-awq
LOCAL_CHAT_MAX_MODEL_LEN=4096
LOCAL_CHAT_GPU_MEMORY_UTILIZATION=0.42
LOCAL_CHAT_PORT=8002
LOCAL_CHAT_CACHE_PATH=./.cache/huggingface
LOCAL_EMBEDDING_IMAGE=vllm/vllm-openai:v0.32.0
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_MODEL_PATH=/models/bge-m3
LOCAL_EMBEDDING_MODEL_PATH_HOST=./models/bge-m3
LOCAL_EMBEDDING_API_KEY=local-embedding-key
LOCAL_EMBEDDING_PORT=8001
LOCAL_EMBEDDING_GPU_MEMORY_UTILIZATION=0.55
LOCAL_EMBEDDING_CACHE_PATH=./.cache/huggingface
LOCAL_EMBEDDING_CPU_MAX_BATCH_SIZE=4
LOCAL_EMBEDDING_CPU_THREADS=4
LOCAL_EMBEDDING_CPU_PORT=8003

# Optional GraphRAG
AI_NEO4J_ENABLED=true
AI_NEO4J_URI=bolt://neo4j:7687
AI_NEO4J_USERNAME=neo4j
AI_NEO4J_PASSWORD=local-change-this-neo4j-password

# Optional local face service; prepare ONNX files in ./models/face first
FACE_SERVICE_URL=http://face:8092
FACE_MODELS_PATH_HOST=./models/face
FACE_SERVICE_PORT=8092
FACE_TEMPLATE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
FACE_MATCH_THRESHOLD=0.42
FACE_AMBIGUITY_MARGIN=0.06
FACE_ANTISPOOF_REAL_CLASS_INDEX=-1
FACE_ANTISPOOF_INPUT_SIZE=80
FACE_ANTISPOOF_THRESHOLD=0.80


# ERP 对接（可选；留空时后端以 MOCK 模式模拟同步成功，便于本地演示）
ERP_BASE_URL=
ERP_APP_ID=
ERP_APP_SECRET=

# PostgreSQL 16（docker-compose 内服务名 postgres；关系库与 AI 向量库 mes_ai 同实例不同库）
# 本机开发默认端口 5433；容器内部始终使用 5432
DB_HOST=localhost
DB_PORT=5433
DB_NAME=bike_assembly_mes
DB_USERNAME=mes
DB_PASSWORD=mes123456

# Redis（缓存/登录锁定；不可用时自动降级）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ（APP_RABBITMQ_ENABLED=true 时后端会连接）
APP_RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mes
RABBITMQ_PASSWORD=mes123456
RABBITMQ_VHOST=/

# CORS 白名单（逗号分隔）
BIKE_CORS_ALLOWED_ORIGINS=http://localhost:8081

# Web 构建 API 基址：留空表示同源（由 nginx 反代 /admin /app /ws）
VITE_API_BASE_URL=

# 对外端口
BACKEND_PORT=8080
WEB_PORT=8081
