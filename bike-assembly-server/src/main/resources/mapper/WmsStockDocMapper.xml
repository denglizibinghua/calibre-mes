<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bikeassembly.mapper.WmsStockDocMapper">

    <select id="selectByIdForUpdate" resultType="com.bikeassembly.entity.WmsStockDoc">
        SELECT * FROM wms_stock_doc WHERE doc_id = #{docId} FOR UPDATE
    </select>

    <!-- 基础 CRUD 已由 MyBatis-Plus BaseMapper 提供，此处只写自定义查询 -->

    <!-- V3：动态条件分页查询出入库单 -->
    <select id="selectPageByCondition" resultType="com.bikeassembly.entity.WmsStockDoc">
        SELECT *
        FROM wms_stock_doc
        <where>
            <if test="docNo != null and docNo != ''">
                AND doc_no LIKE concat('%', #{docNo}, '%')
            </if>
            <if test="docType != null and docType != ''">
                AND doc_type = #{docType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND details_json LIKE concat('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
