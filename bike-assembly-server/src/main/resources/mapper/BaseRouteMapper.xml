<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bikeassembly.mapper.BaseRouteMapper">

    <!-- 基础 CRUD 已由 MyBatis-Plus BaseMapper 提供，此处只写自定义查询 -->

    <select id="countReferences" resultType="int">
        SELECT COUNT(*) FROM (
            SELECT 1 FROM pro_work_order WHERE route_id = #{routeId}
        ) t
    </select>

</mapper>
