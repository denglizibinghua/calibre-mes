<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bikeassembly.mapper.EqmRepairOrderMapper">

    <select id="selectPageByCondition" resultType="com.bikeassembly.entity.EqmRepairOrder">
        SELECT *
        FROM eqm_repair_order
        <where>
            <if test="reporterUserId != null">
                AND reporter_user_id = #{reporterUserId}
            </if>
            <if test="handlerUserId != null">
                AND handler_user_id = #{handlerUserId}
            </if>
            <if test="isPending != null and isPending == true">
                AND handler_user_id IS NULL
                AND status = '0'
            </if>
        </where>
        ORDER BY report_time DESC
    </select>

</mapper>
